// @title: Parallel Sum
// @description: Parallel computation with result collection via channels
// @order: 24
// @category: Concurrency

// === Observability Tips ===
// - Watch SPAWN events as worker fibers are created
// - MSG events show partial sums being sent to the result channel
// - Use Debug panel to inspect local variables

fn sum_range(id: int, start: int, end_val: int, results: Channel<int>) {
    println("Worker " + id + ": Summing from " + start + " to " + end_val)
    var sum = 0
    var i = start
    while i <= end_val {
        sum = sum + i
        i = i + 1
    }
    println("Worker " + id + ": Partial sum = " + sum)
    select { sum -> results => println("Worker " + id + ": Sent") }
}

fn main() {
    println("=== Parallel Sum Demo ===")
    println("Computing sum of 1 to 100 using 4 workers")
    println("")

    let results = chan(4)

    // Split range 1-100 into 4 chunks
    spawn sum_range(1, 1, 25, results)
    spawn sum_range(2, 26, 50, results)
    spawn sum_range(3, 51, 75, results)
    spawn sum_range(4, 76, 100, results)

    println("Main: Waiting for partial results...")

    // Collect partial sums
    var collected = 0
    while collected < 4 {
        fiber_yield()
        select {
            <-results => {
                collected = collected + 1
                println("Main: Received partial sum #" + collected)
            }
            _ => fiber_yield()
        }
    }

    println("")
    println("Collected all 4 partial sums")
    // Expected sum of 1 to 100 = n(n+1)/2 = 100*101/2 = 5050
    println("Expected total: 5050")

    println("")
    println("=== Demo Complete ===")
}

main()

// @expect-contains: === Parallel Sum Demo ===
// @expect-contains: Collected all 4 partial sums
// @expect-contains: Expected total: 5050
// @expect-contains: === Demo Complete ===
