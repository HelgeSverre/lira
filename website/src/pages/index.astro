---
import Layout from "../layouts/Layout.astro";
import Code from "../components/Code.astro";
import Starfield from "../components/Starfield.astro";

const github = "https://github.com/HelgeSverre/lira";

// Each feature row embeds a real, verified .li file. The check:examples
// harness runs every one of these through the compiler before each build.
// Snippets are kept to a similar length so the alternating rows stay balanced.
const features = [
  {
    kicker: "Concurrency",
    title: "Fibers and channels",
    body: "Spawn lightweight fibers and coordinate them over typed channels. Receive with a bound select — the value lands in a variable, with no shared-memory guesswork.",
    file: "website/src/snippets/concurrency.li",
    filename: "concurrency.li",
  },
  {
    kicker: "Pattern matching",
    title: "Match on shape, exhaustively",
    body: "Destructure with literals, bindings, and nested tuples. The checker enforces exhaustiveness, so an unhandled case is a compile error — not a runtime surprise.",
    file: "website/src/snippets/patterns-tuples.li",
    filename: "patterns.li",
  },
  {
    kicker: "Generics",
    title: "Build your own Option and Result",
    body: "Write generic functions, structs, and enums. Roll Option- or Result-shaped types yourself — fully type-checked, then erased at runtime.",
    file: "website/src/snippets/patterns-option.li",
    filename: "option.li",
  },
  {
    kicker: "Error handling",
    title: "Errors as values",
    body: "Return Result, propagate failures with the ? operator, and handle them by matching. No exceptions, no hidden control flow.",
    file: "examples/result_propagation.li",
    filename: "result.li",
  },
];
---

<Layout>
  <section class="hero">
    <Starfield />
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">The Lira programming language</p>
        <h1>
          Systems programming,
          <span class="accent">in harmony</span>.
        </h1>
        <p class="hero__lede">
          Lira pairs Go-style fiber concurrency with pattern matching and
          generics. Programs are statically type-checked, compiled to bytecode,
          and run on a compact VM.
        </p>
        <div class="hero__cta">
          <a class="btn btn-primary" href="/guide">Read the guide</a>
          <a
            class="btn btn-secondary"
            href={github}
            rel="noopener"
            target="_blank">View on GitHub</a
          >
        </div>
      </div>
      <div class="hero__code">
        <Code file="website/src/snippets/pipeline.li" filename="pipeline.li" />
        <p class="hero__caption">
          Two fibers compute in parallel; <code>main</code> collects both results
          with a bound <code>select</code>.
        </p>
      </div>
    </div>
  </section>

  <section class="features container">
    <header class="features__head">
      <h2>Built for programs that do several things at once</h2>
      <p>
        Every snippet below is a real <code>.li</code> file in this repository, verified
        to compile and run before the site is built.
      </p>
    </header>

    <div class="rows">
      {
        features.map((f) => (
          <article class="row">
            <div class="row__copy">
              <p class="row__kick">
                <span class="row__num" /> {f.kicker}
              </p>
              <h3>{f.title}</h3>
              <p class="row__body">{f.body}</p>
            </div>
            <div class="row__code">
              <Code file={f.file} filename={f.filename} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="diag container">
    <div class="diag__copy">
      <h2>Located diagnostics</h2>
      <p>
        The checker reports type and binding errors with a
        <code>line:column</code> location, before any bytecode is generated.
      </p>
    </div>
    <div class="diag__term" role="img" aria-label="Compiler error output examples">
      <pre><span class="term__cmd">$ lira run mismatch.li</span>
<span class="term__err">5:20: Argument type mismatch: expected 'int', got 'string'</span>

<span class="term__cmd">$ lira run undefined.li</span>
<span class="term__err">3:13: Undefined variable: y</span></pre>
    </div>
  </section>

  <section class="closing container">
    <h2>Tune in.</h2>
    <p>
      Start with the guide, or read the source. Lira is early, and the guide is
      clear about what works today.
    </p>
    <div class="closing__cta">
      <a class="btn btn-primary" href="/guide">Get started</a>
      <a class="btn btn-secondary" href={github} rel="noopener" target="_blank"
        >Star on GitHub</a
      >
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--gradient-hero);
    border-bottom: 1px solid var(--border);
    padding: var(--sp-16) 0 var(--sp-12);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--sp-8);
    align-items: center;
  }
  .hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--lira-gold);
    margin-bottom: var(--sp-2);
  }
  .hero h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .accent {
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lede {
    color: var(--text-muted);
    font-size: 1.125rem;
    max-width: 52ch;
    margin-bottom: var(--sp-4);
  }
  .hero__cta {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .hero__caption {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .hero__caption code {
    color: var(--starlight);
  }

  /* Features */
  .features {
    padding-top: var(--sp-12);
  }
  .features__head {
    max-width: 60ch;
    margin-bottom: var(--sp-6);
  }
  .features__head p {
    color: var(--text-muted);
  }
  .features__head code {
    color: var(--starlight);
    font-size: 0.95em;
  }

  /* Alternating text / code rows.
     Each feature is a full-width chapter: prose on one side, code on the
     other, flipping sides row to row. Because rows stack (rather than sit in a
     grid) the differing snippet heights read as intentional, not misaligned. */
  .rows {
    counter-reset: feat;
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
    margin-top: var(--sp-8);
  }
  .row {
    counter-increment: feat;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--sp-8);
    align-items: center;
  }
  /* Default: copy left, code right. Even rows flip. */
  .row__copy {
    order: 1;
  }
  .row__code {
    order: 2;
    min-width: 0; /* let the code scroll internally instead of overflowing */
  }
  .row:nth-child(even) .row__copy {
    order: 2;
  }
  .row:nth-child(even) .row__code {
    order: 1;
  }
  .row__kick {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--lira-gold);
    margin-bottom: var(--sp-2);
  }
  .row__num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--lira-gold-bright);
    letter-spacing: 0.05em;
  }
  .row__num::before {
    content: counter(feat, decimal-leading-zero);
  }
  .row__num::after {
    content: "";
    display: inline-block;
    width: var(--sp-3);
    height: 1px;
    margin-left: var(--sp-1);
    vertical-align: middle;
    background: var(--lira-gold);
    opacity: 0.5;
  }
  .row__copy h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 var(--sp-2);
  }
  .row__body {
    color: var(--text-muted);
    font-size: 1.0625rem;
    max-width: 46ch;
    margin: 0;
  }
  /* A soft gold-tinted lift on the code so each specimen feels like the
     focal point of its row. */
  .row__code :global(.specimen) {
    box-shadow:
      var(--elevation-1),
      0 0 0 1px rgba(232, 169, 36, 0.06),
      0 18px 50px -28px rgba(232, 169, 36, 0.28);
  }

  /* Diagnostics */
  .diag {
    margin-top: var(--sp-16);
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--sp-6);
    align-items: center;
  }
  .diag__copy p {
    color: var(--text-muted);
  }
  .diag__copy code {
    color: var(--starlight);
  }
  .diag__term {
    background: var(--night);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--sp-3);
    box-shadow: var(--elevation-1);
    overflow-x: auto;
  }
  .diag__term pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    line-height: 1.7;
    color: var(--snow);
  }
  .term__cmd {
    color: var(--text-muted);
  }
  .term__err {
    color: var(--ember);
  }

  /* Closing */
  .closing {
    margin-top: var(--sp-16);
    text-align: center;
  }
  .closing p {
    color: var(--text-muted);
    max-width: 48ch;
    margin: 0 auto var(--sp-4);
  }
  .closing__cta {
    display: flex;
    gap: var(--sp-2);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .hero__inner,
    .diag {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: var(--sp-8);
    }
    /* Stack each row: copy always above its code. */
    .row {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }
    .row__copy,
    .row:nth-child(even) .row__copy {
      order: 1;
    }
    .row__code,
    .row:nth-child(even) .row__code {
      order: 2;
    }
    .rows {
      gap: var(--sp-8);
    }
  }
</style>
