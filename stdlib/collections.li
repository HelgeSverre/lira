// Lira Standard Library - Collections Module
// Array operations using impl blocks for method syntax.
//
// Usage:
//   let arr = [1, 2, 3, 4, 5]
//   println(arr.sum())           // 15
//   println(arr.contains(3))     // true
//   println(arr.reverse())       // [5, 4, 3, 2, 1]

// ============================================================================
// Integer Array Operations
// ============================================================================

impl [int] {
    // ------------------------------------------------------------------------
    // Transformation
    // ------------------------------------------------------------------------

    /// Double each element
    fn map_double(self) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < len(self) {
            push(result, self[i] * 2)
            i = i + 1
        }
        return result
    }

    /// Square each element
    fn map_square(self) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < len(self) {
            push(result, self[i] * self[i])
            i = i + 1
        }
        return result
    }

    // ------------------------------------------------------------------------
    // Filtering
    // ------------------------------------------------------------------------

    /// Filter positive numbers
    fn filter_positive(self) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < len(self) {
            if self[i] > 0 {
                push(result, self[i])
            }
            i = i + 1
        }
        return result
    }

    /// Filter even numbers
    fn filter_even(self) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < len(self) {
            if self[i] % 2 == 0 {
                push(result, self[i])
            }
            i = i + 1
        }
        return result
    }

    /// Filter odd numbers
    fn filter_odd(self) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < len(self) {
            if self[i] % 2 != 0 {
                push(result, self[i])
            }
            i = i + 1
        }
        return result
    }

    // ------------------------------------------------------------------------
    // Reduction
    // ------------------------------------------------------------------------

    /// Sum all elements
    fn sum(self) -> int {
        var total = 0
        var i = 0
        while i < len(self) {
            total = total + self[i]
            i = i + 1
        }
        return total
    }

    /// Product of all elements
    fn product(self) -> int {
        var result = 1
        var i = 0
        while i < len(self) {
            result = result * self[i]
            i = i + 1
        }
        return result
    }

    /// Find minimum value
    fn min(self) -> int {
        if len(self) == 0 {
            return 0
        }
        var m = self[0]
        var i = 1
        while i < len(self) {
            if self[i] < m {
                m = self[i]
            }
            i = i + 1
        }
        return m
    }

    /// Find maximum value
    fn max(self) -> int {
        if len(self) == 0 {
            return 0
        }
        var m = self[0]
        var i = 1
        while i < len(self) {
            if self[i] > m {
                m = self[i]
            }
            i = i + 1
        }
        return m
    }

    /// Calculate average
    fn average(self) -> float {
        if len(self) == 0 {
            return 0.0
        }
        return self.sum() / len(self)
    }

    // ------------------------------------------------------------------------
    // Search
    // ------------------------------------------------------------------------

    /// Check if array contains value
    fn contains(self, value: int) -> bool {
        var i = 0
        while i < len(self) {
            if self[i] == value {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// Find index of value (-1 if not found)
    fn index_of(self, value: int) -> int {
        var i = 0
        while i < len(self) {
            if self[i] == value {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// Count occurrences of value
    fn count(self, value: int) -> int {
        var c = 0
        var i = 0
        while i < len(self) {
            if self[i] == value {
                c = c + 1
            }
            i = i + 1
        }
        return c
    }

    // ------------------------------------------------------------------------
    // Manipulation
    // ------------------------------------------------------------------------

    /// Reverse array
    fn reverse(self) -> [int] {
        let result = [0]
        pop(result)
        var i = len(self) - 1
        while i >= 0 {
            push(result, self[i])
            i = i - 1
        }
        return result
    }

    /// Take first n elements
    fn take(self, n: int) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        var cnt = n
        if cnt > len(self) {
            cnt = len(self)
        }
        while i < cnt {
            push(result, self[i])
            i = i + 1
        }
        return result
    }

    /// Skip first n elements
    fn skip(self, n: int) -> [int] {
        let result = [0]
        pop(result)
        var i = n
        while i < len(self) {
            push(result, self[i])
            i = i + 1
        }
        return result
    }

    /// Slice from start to end (exclusive)
    fn slice(self, start: int, end: int) -> [int] {
        let result = [0]
        pop(result)
        var i = start
        while i < end && i < len(self) {
            push(result, self[i])
            i = i + 1
        }
        return result
    }

    /// Remove duplicates (keep first occurrence)
    fn unique(self) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < len(self) {
            if !result.contains(self[i]) {
                push(result, self[i])
            }
            i = i + 1
        }
        return result
    }

    /// Concatenate with another array
    fn concat(self, other: [int]) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < len(self) {
            push(result, self[i])
            i = i + 1
        }
        i = 0
        while i < len(other) {
            push(result, other[i])
            i = i + 1
        }
        return result
    }

    // ------------------------------------------------------------------------
    // Sorting
    // ------------------------------------------------------------------------

    /// Sort in ascending order (selection sort)
    fn sort(self) -> [int] {
        let result = [0]
        pop(result)

        if len(self) == 0 {
            return result
        }

        // Create tracking array for used indices
        let used = [0]
        pop(used)
        var k = 0
        while k < len(self) {
            push(used, 0)
            k = k + 1
        }

        // Selection sort: find min element not yet used
        var count = 0
        while count < len(self) {
            var min_idx = -1
            var min_val = 0
            var j = 0
            while j < len(self) {
                if used[j] == 0 {
                    if min_idx == -1 || self[j] < min_val {
                        min_idx = j
                        min_val = self[j]
                    }
                }
                j = j + 1
            }

            // Mark as used
            let new_used = [0]
            pop(new_used)
            j = 0
            while j < len(used) {
                if j == min_idx {
                    push(new_used, 1)
                } else {
                    push(new_used, used[j])
                }
                j = j + 1
            }
            while len(used) > 0 {
                pop(used)
            }
            j = 0
            while j < len(new_used) {
                push(used, new_used[j])
                j = j + 1
            }

            push(result, min_val)
            count = count + 1
        }

        return result
    }

    /// Sort in descending order
    fn sort_desc(self) -> [int] {
        return self.sort().reverse()
    }

    // ------------------------------------------------------------------------
    // Boolean Operations
    // ------------------------------------------------------------------------

    /// Check if all elements are non-zero
    fn all_truthy(self) -> bool {
        var i = 0
        while i < len(self) {
            if self[i] == 0 {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// Check if any element is non-zero
    fn any_truthy(self) -> bool {
        var i = 0
        while i < len(self) {
            if self[i] != 0 {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// Check if no elements are non-zero
    fn none_truthy(self) -> bool {
        return !self.any_truthy()
    }

    /// Create array with value repeated n times
    fn repeat(value: int, n: int) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < n {
            push(result, value)
            i = i + 1
        }
        return result
    }
}

// ============================================================================
// Nested Integer Array Operations
// ============================================================================

impl [[int]] {
    /// Flatten nested arrays into single array
    fn flatten(self) -> [int] {
        let result = [0]
        pop(result)
        var i = 0
        while i < len(self) {
            var j = 0
            while j < len(self[i]) {
                push(result, self[i][j])
                j = j + 1
            }
            i = i + 1
        }
        return result
    }
}

// ============================================================================
// String Array Operations
// ============================================================================

impl [string] {
    /// Check if string array contains value
    fn contains(self, value: string) -> bool {
        var i = 0
        while i < len(self) {
            if self[i] == value {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// Find index of value (-1 if not found)
    fn index_of(self, value: string) -> int {
        var i = 0
        while i < len(self) {
            if self[i] == value {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// Reverse string array
    fn reverse(self) -> [string] {
        let result = [""]
        pop(result)
        var i = len(self) - 1
        while i >= 0 {
            push(result, self[i])
            i = i - 1
        }
        return result
    }
}

// ============================================================================
// Standalone Generation Functions
// ============================================================================

/// Generate range [start, end)
fn range(start: int, end: int) -> [int] {
    let result = [0]
    pop(result)
    var i = start
    while i < end {
        push(result, i)
        i = i + 1
    }
    return result
}

/// Generate range with step
fn range_step(start: int, end: int, step: int) -> [int] {
    let result = [0]
    pop(result)
    var i = start
    if step > 0 {
        while i < end {
            push(result, i)
            i = i + step
        }
    } else if step < 0 {
        while i > end {
            push(result, i)
            i = i + step
        }
    }
    return result
}
