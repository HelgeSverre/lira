// Lira Standard Library - Random Module
// Random number generation utilities

// Generate random float between 0.0 and 1.0
// random() is a built-in that maps to syscall 40

// Generate random integer between min and max (inclusive)
// random_int(min, max) is a built-in that maps to syscall 41

// Generate random boolean
fn random_bool() -> bool {
    return random() < 0.5
}

// Generate random float in range [min, max)
fn random_range(min: float, max: float) -> float {
    return min + random() * (max - min)
}

// Generate random index for an array of given length
fn random_index(length: int) -> int {
    return random_int(0, length - 1)
}

// Shuffle array in place (Fisher-Yates algorithm)
// Returns the same array for convenience
fn shuffle_int_array(arr: [int]) -> [int] {
    var i = len(arr) - 1
    while i > 0 {
        let j = random_int(0, i)
        // Swap arr[i] and arr[j]
        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp
        i = i - 1
    }
    return arr
}

// Generate a random integer with specified number of digits
fn random_digits(num_digits: int) -> int {
    if num_digits <= 0 {
        return 0
    }
    var min_val = 1
    var max_val = 9
    var i = 1
    while i < num_digits {
        min_val = min_val * 10
        max_val = max_val * 10 + 9
        i = i + 1
    }
    return random_int(min_val, max_val)
}

// Generate random coin flip (returns "heads" or "tails")
fn coin_flip() -> string {
    if random_bool() {
        return "heads"
    }
    return "tails"
}

// Generate random dice roll (1-6 by default)
fn dice_roll() -> int {
    return random_int(1, 6)
}

// Generate random dice roll with custom number of sides
fn dice_roll_n(sides: int) -> int {
    return random_int(1, sides)
}
