// Lira Standard Library - Time Module
// Time manipulation and formatting via Timestamp struct.
//
// Usage: timestamp_now().add(5.hours()).format_date()
//
// Built-in functions (direct syscalls):
//   time_ms() -> int              - Current time in milliseconds since epoch (syscall 4)
//   sleep(ms: int)                - Sleep for milliseconds (syscall 5)
//   time_secs() -> int            - Current time in seconds since epoch (syscall 6)
//   time_micros() -> int          - Current time in microseconds since epoch (syscall 7)
//   time_nanos() -> int           - Current time in nanoseconds since epoch (syscall 8)
//   time_format_iso(ms) -> string - Format timestamp as ISO 8601 string (syscall 130)
//   time_format(ms, fmt) -> string- Format timestamp with custom format (syscall 131)
//   time_parse_iso(str) -> int    - Parse ISO 8601 string to timestamp (syscall 132)
//   time_timezone_offset() -> int - Get local timezone offset in minutes (syscall 133)
//   time_components(ms) -> [int]  - Get [year, month, day, hour, min, sec] (syscall 134)
//   time_from_components(y, m, d, h, m, s) -> int - Create timestamp from components (syscall 135)

// ============================================================================
// Duration Methods on int
// ============================================================================

impl int {
    /// Convert seconds to milliseconds
    fn seconds(self) -> int {
        return self * 1000
    }

    /// Convert minutes to milliseconds
    fn minutes(self) -> int {
        return self * 60000
    }

    /// Convert hours to milliseconds
    fn hours(self) -> int {
        return self * 3600000
    }

    /// Convert days to milliseconds
    fn days(self) -> int {
        return self * 86400000
    }

    /// Convert weeks to milliseconds
    fn weeks(self) -> int {
        return self * 604800000
    }
}

// ============================================================================
// Timestamp Struct
// ============================================================================

struct Timestamp {
    ms: int
}

// ============================================================================
// Timestamp Constructor Functions
// ============================================================================

/// Create timestamp for current time
fn timestamp_now() -> Timestamp {
    return Timestamp { ms: time_ms() }
}

/// Create timestamp from milliseconds since epoch
fn timestamp_from_ms(ms: int) -> Timestamp {
    return Timestamp { ms: ms }
}

/// Create timestamp from date components
fn timestamp_from_date(year: int, month: int, day: int) -> Timestamp {
    return Timestamp { ms: time_from_components(year, month, day, 0, 0, 0) }
}

/// Create timestamp from datetime components
fn timestamp_from_datetime(year: int, month: int, day: int, hour: int, minute: int, second: int) -> Timestamp {
    return Timestamp { ms: time_from_components(year, month, day, hour, minute, second) }
}

/// Parse ISO 8601 string to timestamp
fn timestamp_parse_iso(s: string) -> Timestamp {
    return Timestamp { ms: time_parse_iso(s) }
}

// ============================================================================
// Timestamp Methods
// ============================================================================

impl Timestamp {
    // ========================================================================
    // Formatting
    // ========================================================================

    /// Format as ISO 8601 string
    fn to_iso(self) -> string {
        return time_format_iso(self.ms)
    }

    /// Format with custom format string
    fn format(self, fmt: string) -> string {
        return time_format(self.ms, fmt)
    }

    /// Format as date only (YYYY-MM-DD)
    fn format_date(self) -> string {
        return time_format(self.ms, "%Y-%m-%d")
    }

    /// Format as time only (HH:MM:SS)
    fn format_time(self) -> string {
        return time_format(self.ms, "%H:%M:%S")
    }

    /// Format as datetime (YYYY-MM-DD HH:MM:SS)
    fn format_datetime(self) -> string {
        return time_format(self.ms, "%Y-%m-%d %H:%M:%S")
    }

    /// Format as human-readable date (e.g., "January 1, 2024")
    fn format_readable(self) -> string {
        return time_format(self.ms, "%B %d, %Y")
    }

    // ========================================================================
    // Arithmetic
    // ========================================================================

    /// Add duration in milliseconds
    fn add(self, duration_ms: int) -> Timestamp {
        return Timestamp { ms: self.ms + duration_ms }
    }

    /// Subtract duration in milliseconds
    fn subtract(self, duration_ms: int) -> Timestamp {
        return Timestamp { ms: self.ms - duration_ms }
    }

    /// Get difference between timestamps in milliseconds
    fn diff(self, other: Timestamp) -> int {
        return self.ms - other.ms
    }

    /// Elapsed milliseconds since this timestamp
    fn elapsed(self) -> int {
        return time_ms() - self.ms
    }

    /// Elapsed seconds since this timestamp
    fn elapsed_secs(self) -> int {
        return (time_ms() - self.ms) / 1000
    }

    // ========================================================================
    // Comparisons
    // ========================================================================

    /// Check if this timestamp is before another
    fn is_before(self, other: Timestamp) -> bool {
        return self.ms < other.ms
    }

    /// Check if this timestamp is after another
    fn is_after(self, other: Timestamp) -> bool {
        return self.ms > other.ms
    }

    /// Check if timestamp is in the past
    fn is_past(self) -> bool {
        return self.ms < time_ms()
    }

    /// Check if timestamp is in the future
    fn is_future(self) -> bool {
        return self.ms > time_ms()
    }

    /// Check if timestamp is today
    fn is_today(self) -> bool {
        let now_comp = time_components(time_ms())
        let ts_comp = time_components(self.ms)
        return now_comp[0] == ts_comp[0] && now_comp[1] == ts_comp[1] && now_comp[2] == ts_comp[2]
    }

    // ========================================================================
    // Component Extraction
    // ========================================================================

    /// Get year component
    fn year(self) -> int {
        let comp = time_components(self.ms)
        return comp[0]
    }

    /// Get month component (1-12)
    fn month(self) -> int {
        let comp = time_components(self.ms)
        return comp[1]
    }

    /// Get day component (1-31)
    fn day(self) -> int {
        let comp = time_components(self.ms)
        return comp[2]
    }

    /// Get hour component (0-23)
    fn hour(self) -> int {
        let comp = time_components(self.ms)
        return comp[3]
    }

    /// Get minute component (0-59)
    fn minute(self) -> int {
        let comp = time_components(self.ms)
        return comp[4]
    }

    /// Get second component (0-59)
    fn second(self) -> int {
        let comp = time_components(self.ms)
        return comp[5]
    }

    /// Get all components as array [year, month, day, hour, minute, second]
    fn components(self) -> [int] {
        return time_components(self.ms)
    }
}

// ============================================================================
// Standalone Functions
// ============================================================================

/// Get current date as string (YYYY-MM-DD)
fn today() -> string {
    return time_format(time_ms(), "%Y-%m-%d")
}

/// Get current time as string (HH:MM:SS)
fn now_time() -> string {
    return time_format(time_ms(), "%H:%M:%S")
}

/// Get current datetime as ISO 8601 string
fn now_iso() -> string {
    return time_format_iso(time_ms())
}

/// Get local timezone offset in minutes
fn timezone_offset() -> int {
    return time_timezone_offset()
}
