// Lira Standard Library - Core Module
// Provides fundamental types and utilities.
//
// Usage: (-5).abs() instead of abs(-5)

// ============================================================================
// Constants
// ============================================================================

// File open modes
let FILE_READ = 0
let FILE_WRITE = 1
let FILE_APPEND = 2
let FILE_READWRITE = 3

// ============================================================================
// Integer Methods
// ============================================================================

impl int {
    /// Absolute value
    fn abs(self) -> int {
        if self < 0 {
            return -self
        }
        return self
    }

    /// Clamp value to range [min_val, max_val]
    fn clamp(self, min_val: int, max_val: int) -> int {
        if self < min_val {
            return min_val
        }
        if self > max_val {
            return max_val
        }
        return self
    }
}

// ============================================================================
// Standalone Functions (two-argument comparisons)
// ============================================================================

/// Minimum of two values
fn min(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

/// Maximum of two values
fn max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}
