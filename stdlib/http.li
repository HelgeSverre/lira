// Lira Standard Library - HTTP Module
// HTTP client functionality (inspired by Perl's LWP::UserAgent)

// ============================================================================
// Built-in primitives (implemented in runtime, directly accessible)
// ============================================================================
//
// http_get(url: string) -> [status: int, body: string]
//   Performs an HTTP GET request and returns [status_code, response_body]
//   Example: let result = http_get("https://example.com")
//            let status: int = result[0]
//            let body: string = result[1]
//
// http_post(url: string, body: string, content_type: string) -> [status, body]
//   Performs an HTTP POST request and returns [status_code, response_body]
//   Example: let result = http_post("https://api.example.com", "{}", "application/json")
//
// http_request(method: string, url: string, headers: string, body: string) -> [status, body]
//   Performs a custom HTTP request with the given method, headers, and body
//   Headers should be formatted as "Header-Name: value\nAnother-Header: value"
//   Example: let result = http_request("PUT", url, "Content-Type: application/json", data)

// ============================================================================
// Status Code Helpers
// ============================================================================

// Check if status code indicates success (2xx)
fn is_success(status: int) -> bool {
    return status >= 200 && status < 300
}

// Check if status code indicates redirect (3xx)
fn is_redirect(status: int) -> bool {
    return status >= 300 && status < 400
}

// Check if status code indicates client error (4xx)
fn is_client_error(status: int) -> bool {
    return status >= 400 && status < 500
}

// Check if status code indicates server error (5xx)
fn is_server_error(status: int) -> bool {
    return status >= 500 && status < 600
}

// Check if status code indicates any error (4xx or 5xx)
fn is_error(status: int) -> bool {
    return status >= 400
}

// ============================================================================
// Simple GET helpers (return body only)
// ============================================================================

// Simple GET request that returns just the body (or empty string on error)
fn get(url: string) -> string {
    let result = http_get(url)
    let status: int = result[0]
    if status >= 200 && status < 300 {
        return result[1]
    }
    return ""
}

// GET request that only returns body if status is 2xx, empty string otherwise
fn get_ok(url: string) -> string {
    return get(url)
}

// ============================================================================
// Simple POST helpers (return body only)
// ============================================================================

// POST JSON data, returns response body
fn post_json(url: string, data: string) -> string {
    let result = http_post(url, data, "application/json")
    return result[1]
}

// POST form data (application/x-www-form-urlencoded), returns response body
fn post_form(url: string, data: string) -> string {
    let result = http_post(url, data, "application/x-www-form-urlencoded")
    return result[1]
}

// POST plain text, returns response body
fn post_text(url: string, data: string) -> string {
    let result = http_post(url, data, "text/plain")
    return result[1]
}

// ============================================================================
// Usage Examples (in comments)
// ============================================================================
//
// Example 1: Simple GET
//   let body = get("https://example.com")
//   println(body)
//
// Example 2: GET with status check
//   let result = http_get("https://api.example.com/data")
//   let status: int = result[0]
//   let body: string = result[1]
//   if is_success(status) {
//       println("Success: " + body)
//   } else if is_client_error(status) {
//       println("Client error: " + status)
//   } else {
//       println("Server error: " + status)
//   }
//
// Example 3: POST JSON
//   let response = post_json("https://api.example.com", "{\"key\": \"value\"}")
//   println(response)
//
// Example 4: Custom request with headers
//   let result = http_request("PUT", url, "Authorization: Bearer token\nContent-Type: application/json", data)
//   let status: int = result[0]
//   let body: string = result[1]
