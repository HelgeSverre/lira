// Lira Standard Library - Environment Module
// Environment variable operations

// Built-in functions:
// env_get(name) -> string? - Get env var (syscall 20)
// env_args() -> [string] - Get command line args (syscall 21)
// env_set(name, value) -> bool - Set env var (syscall 200)
// env_remove(name) -> bool - Remove env var (syscall 201)
// env_all() -> [string] - Get all env vars as key=value (syscall 202)
// env_keys() -> [string] - Get all env var names (syscall 203)
// env_has(name) -> bool - Check if env var exists (syscall 204)
// env_exe() -> string - Get executable path (syscall 205)
// env_temp_dir() -> string - Get temp directory (syscall 206)
// env_home_dir() -> string - Get home directory (syscall 207)

// Get env var with default value
fn get_or(name: string, default_value: string) -> string {
    let value = env_get(name)
    if value == null {
        return default_value
    }
    // Convert optional to string by concatenating with empty string
    return "" + value
}

// Get env var as bool
fn get_bool(name: string) -> bool {
    let value = env_get(name)
    if value == null {
        return false
    }
    let v = "" + value
    return v == "1" || v == "true" || v == "yes" || v == "on"
}

// Check if running in CI environment
fn is_ci() -> bool {
    return env_has("CI") || env_has("GITHUB_ACTIONS") || env_has("GITLAB_CI") || env_has("JENKINS_HOME")
}

// Check if debug mode
fn is_debug() -> bool {
    return get_bool("DEBUG") || get_bool("LI_DEBUG")
}

// Get current user
fn user() -> string {
    let u = env_get("USER")
    if u != null {
        return "" + u
    }
    return get_or("USERNAME", "")
}

// Get shell
fn shell() -> string {
    return get_or("SHELL", "/bin/sh")
}
