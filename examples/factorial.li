// Factorial Calculation
// Demonstrates both recursive and iterative approaches

// Recursive factorial
fn factorial_recursive(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial_recursive(n - 1)
}

// Iterative factorial
fn factorial_iterative(n: int) -> int {
    var result = 1
    var i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

// Test both implementations
println("Factorial of 5 (recursive):")
println(factorial_recursive(5))

println("Factorial of 5 (iterative):")
println(factorial_iterative(5))

println("Factorial of 10 (recursive):")
println(factorial_recursive(10))

println("Factorial of 10 (iterative):")
println(factorial_iterative(10))
