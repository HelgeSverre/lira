// Comprehensive Control Flow Tests
// Tests if/else, while loops, break, continue, and nested structures

println("=== If/Else Tests ===")

// Simple if
if true {
    println("true branch")
}

// If-else
if false {
    println("ERROR: false branch")
} else {
    println("else branch")
}

// If-else if-else chain
let x = 2
if x == 1 {
    println("ERROR: x is 1")
} else if x == 2 {
    println("x is 2")
} else {
    println("ERROR: x is something else")
}

// Nested if
if x > 0 {
    if x < 10 {
        println("x is between 0 and 10")
    }
}

println("=== While Loop Tests ===")

// Simple while
var count = 0
while count < 3 {
    println(count)
    count = count + 1
}

// While with condition check
count = 10
while count > 0 {
    count = count - 2
}
println("Count after loop:")
println(count)

println("=== Break Tests ===")

// Break from while
count = 0
while true {
    if count == 5 {
        break
    }
    count = count + 1
}
println("Broke at count:")
println(count)

// Break in nested loop
var outer = 0
var inner = 0
while outer < 10 {
    inner = 0
    while inner < 10 {
        if inner == 3 {
            break
        }
        inner = inner + 1
    }
    outer = outer + 1
    if outer == 2 {
        break
    }
}
println("Outer after nested break:")
println(outer)

println("=== Continue Tests ===")

// Continue to skip values
var sum = 0
count = 0
while count < 10 {
    count = count + 1
    if count == 5 {
        continue
    }
    sum = sum + count
}
println("Sum (skipping 5):")
println(sum)

println("=== Complex Nested Control Flow ===")

// FizzBuzz using control flow
count = 1
while count <= 15 {
    if count % 15 == 0 {
        println("FizzBuzz")
    } else if count % 3 == 0 {
        println("Fizz")
    } else if count % 5 == 0 {
        println("Buzz")
    } else {
        println(count)
    }
    count = count + 1
}

println("=== Expression If ===")

// If as expression
fn sign(n: int) -> string {
    return if n > 0 {
        "positive"
    } else if n < 0 {
        "negative"
    } else {
        "zero"
    }
}

println(sign(5))
println(sign(-3))
println(sign(0))

println("=== All Tests Passed ===")
