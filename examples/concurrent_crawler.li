// Concurrent web crawler — a showcase for Lira's fiber concurrency.
//
// A pool of worker fibers pull URLs off a `work` channel, fetch them over HTTP
// in parallel, extract same-domain links, and push results onto a `done`
// channel. The main fiber coordinates: it seeds the queue, dedupes URLs, feeds
// newly-discovered links back to the workers, and stops when the page budget
// is reached. This is the classic Go-style worker-pool / fan-out-fan-in
// pattern, expressed with `spawn`, `chan`, `send`, and `select`.
//
// Target is https://quotes.toscrape.com — a sandbox site built for scraping
// practice, so crawling it is expected and polite.
//
// PARALLELISM: fibers are cooperative green threads on one VM thread, but
// blocking syscalls like `http_get` are offloaded to an I/O thread pool and the
// calling fiber is parked until the result arrives — so the fetches genuinely
// overlap. With 8 workers this crawl runs several times faster than fetching
// sequentially.
//
// Makes real network requests when run normally. Tests inject a local server
// through LIRA_CRAWLER_BASE_URL. Run it with:
//   lira run examples/concurrent_crawler.li
//
// @test-local-crawler
// @expect-contains: Done. Fetched 4 pages, discovered 4 unique in-domain URLs.

struct Page {
    url: string
    status: int
    nbytes: int
    links: [string]
}

fn starts_with(s: string, prefix: string) -> bool {
    return str_index_of(s, prefix) == 0
}

fn is_asset(url: string) -> bool {
    if str_index_of(url, "/static/") >= 0 { return true }
    if str_index_of(url, ".css") >= 0 { return true }
    if str_index_of(url, ".js") >= 0 { return true }
    if str_index_of(url, ".ico") >= 0 { return true }
    if str_index_of(url, ".png") >= 0 { return true }
    if str_index_of(url, ".jpg") >= 0 { return true }
    return false
}

// Turn an href into an absolute, same-domain URL — or "" to skip it.
fn crawler_origin() -> string {
    let configured = env_get("LIRA_CRAWLER_BASE_URL")
    if configured == null {
        return "https://quotes.toscrape.com"
    }
    var origin = "" + configured
    if len(origin) == 0 {
        return "https://quotes.toscrape.com"
    }
    while len(origin) > 0 && str_substring(origin, len(origin) - 1, len(origin)) == "/" {
        origin = str_substring(origin, 0, len(origin) - 1)
    }
    if origin == "" { return "https://quotes.toscrape.com" }
    return origin
}

fn normalize(href: string, origin: string) -> string {
    if is_asset(href) { return "" }
    if str_index_of(href, "#") >= 0 { return "" }
    if starts_with(href, "//") { return "" }
    if starts_with(href, "/") { return origin + href }
    if href == origin { return href }
    let origin_prefix = origin + "/"
    if starts_with(href, origin_prefix) {
        return href
    }
    return ""
}

fn extract_links(html: string, origin: string) -> [string] {
    // regex_find_all returns whole matches like `href="/page/2/"`; strip the
    // 6-char `href="` prefix and the trailing quote to recover the URL.
    let matches = regex_find_all("href=\"([^\"]+)\"", html)
    var out = []
    var i = 0
    while i < len(matches) {
        let m = matches[i]
        let href = str_substring(m, 6, len(m) - 1)
        let norm = normalize(href, origin)
        if norm != "" { push(out, norm) }
        i = i + 1
    }
    return out
}

fn contains(arr: [string], x: string) -> bool {
    var i = 0
    while i < len(arr) {
        if arr[i] == x { return true }
        i = i + 1
    }
    return false
}

// Worker fiber: fetch URLs from `work` until told to STOP.
fn worker(work: Channel<string>, done: Channel<Page>, origin: string) {
    while true {
        var url = ""
        select { u = <-work => url = u }
        if url == "STOP" { return }
        let r = http_get(url)
        let links = extract_links(r[1], origin)
        send(done, Page { url: url, status: r[0], nbytes: len(r[1]), links: links })
    }
}

fn main() {
    let origin = crawler_origin()
    let seed = origin + "/"
    let max_pages = 20
    let n_workers = 8

    let work = chan(4096)
    let done = chan(4096)

    var visited = [seed]
    var in_flight = 1
    send(work, seed)

    var w = 0
    while w < n_workers {
        spawn worker(work, done, origin)
        w = w + 1
    }

    println("Crawling " + seed)
    println("  " + n_workers + " concurrent workers, budget " + max_pages + " pages")
    println("")

    var crawled = 0
    while in_flight > 0 {
        select {
            page = <-done => {
                in_flight = in_flight - 1
                crawled = crawled + 1
                println("[" + page.status + "] " + page.url + "  (" + len(page.links) + " links, " + page.nbytes + " bytes)")

                var i = 0
                while i < len(page.links) {
                    let link = page.links[i]
                    if !contains(visited, link) {
                        if len(visited) < max_pages {
                            push(visited, link)
                            send(work, link)
                            in_flight = in_flight + 1
                        }
                    }
                    i = i + 1
                }
            }
        }
    }

    // Release the workers now that the queue has drained.
    var s = 0
    while s < n_workers {
        send(work, "STOP")
        s = s + 1
    }

    println("")
    println("Done. Fetched " + crawled + " pages, discovered " + len(visited) + " unique in-domain URLs.")
}

main()
