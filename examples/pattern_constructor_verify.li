// Constructor Pattern Verification Test
// Verify that constructor patterns actually match correctly
// @expect: blue matches blue
// @expect: green matches green
// @expect: red matches red

enum Color {
    Red,
    Green,
    Blue
}

fn describe_color(c: Color) -> string {
    return match c {
        Color::Red => "red matches red",
        Color::Green => "green matches green",
        Color::Blue => "blue matches blue"
    }
}

// Test that each variant matches correctly
println(describe_color(Color::Blue))   // Should be "blue matches blue"
println(describe_color(Color::Green))  // Should be "green matches green"
println(describe_color(Color::Red))    // Should be "red matches red"
