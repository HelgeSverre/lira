// Tail-call optimisation regression tests
// @expect: 2000
// @expect: 15
// @expect: 3628800
// @expect: 125
// @expect: 2.5

// Bug 2: the tail-call rewrite scanned raw bytes and fired when the operand
// byte of the final instruction equalled the Call opcode value (0x60 = 96).
// Here `return 2000` loads constant index 96, whose low byte is 0x60, which
// used to corrupt the LoadConst into a TailCall and return null.
fn colliding_const_return() -> int {
    let a0 = 1000
    let a1 = 1001
    let a2 = 1002
    let a3 = 1003
    let a4 = 1004
    let a5 = 1005
    let a6 = 1006
    let a7 = 1007
    let a8 = 1008
