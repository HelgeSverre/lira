// HTTP Module Tests
// @expect-contains: http module loaded
// @expect-contains: is_success test passed
// @expect-contains: is_client_error test passed
// @expect-contains: is_server_error test passed
// @expect-contains: is_redirect test passed
// @expect-contains: is_error test passed
// @expect-contains: status check passed

import std.http

println("=== HTTP Module Tests ===")
println("http module loaded")

// Test status helpers (don't require network)
if is_success(200) && is_success(201) && is_success(204) && !is_success(404) && !is_success(500) {
    println("is_success test passed")
} else {
    println("is_success test FAILED")
}

if is_client_error(400) && is_client_error(404) && is_client_error(403) && !is_client_error(200) && !is_client_error(500) {
    println("is_client_error test passed")
} else {
    println("is_client_error test FAILED")
}

if is_server_error(500) && is_server_error(502) && is_server_error(503) && !is_server_error(200) && !is_server_error(404) {
    println("is_server_error test passed")
} else {
    println("is_server_error test FAILED")
}

if is_redirect(301) && is_redirect(302) && is_redirect(307) && !is_redirect(200) && !is_redirect(404) {
    println("is_redirect test passed")
} else {
    println("is_redirect test FAILED")
}

if is_error(400) && is_error(404) && is_error(500) && !is_error(200) && !is_error(301) {
    println("is_error test passed")
} else {
    println("is_error test FAILED")
}

println("status check passed")

