// Match with or-patterns (|)
// @expect: vowel
// @expect: vowel
// @expect: vowel
// @expect: vowel
// @expect: vowel
// @expect: other
// @expect: warm
// @expect: warm
// @expect: other
// @expect: 11
// @expect: 22
// @expect: 33
// @expect: 44

fn classify_char(c: int) -> string {
    return match c {
        97 | 101 | 105 | 111 | 117 => "vowel",
        _ => "other"
    }
}

enum Color { Red, Green, Blue }

fn classify_color(c: Color) -> string {
    return match c {
        Color::Red | Color::Green => "warm",
        _ => "other"
    }
}

enum Choice { Left(int), Right(int), Pair(int, int) }

fn choice_value(choice: Choice) -> int {
    return match choice {
        Choice::Left(x) | Choice::Right(x) => x,
        Choice::Pair(x, 0 | 1) => x
    }
}

fn main() {
    println(classify_char(97))
    println(classify_char(101))
    println(classify_char(105))
    println(classify_char(111))
    println(classify_char(117))
    println(classify_char(98))
    println(classify_color(Color::Red))
    println(classify_color(Color::Green))
    println(classify_color(Color::Blue))
    println(choice_value(Choice::Left(11)))
    println(choice_value(Choice::Right(22)))
    println(choice_value(Choice::Pair(33, 0)))
    println(choice_value(Choice::Pair(44, 1)))
}
