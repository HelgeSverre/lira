// Match with range patterns (exclusive and inclusive)
// @expect: low
// @expect: mid
// @expect: high
// @expect: other

fn classify(n: int) -> string {
    return match n {
        0..5 => "low",
        5..=10 => "mid",
        11..20 => "high",
        _ => "other"
    }
}

fn main() {
    println(classify(3))
    println(classify(7))
    println(classify(15))
    println(classify(100))
}
