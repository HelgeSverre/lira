// Test string escape sequences
// @expect: Hello	World
// @expect: Line 1
// @expect: Line 2
// @expect: She said "Hi"
// @expect: Path: C:\Users

fn main() {
    // Tab escape
    println("Hello\tWorld")

    // Newline escape
    println("Line 1")
    println("Line 2")

    // Quote escape
    println("She said \"Hi\"")

    // Backslash escape
    println("Path: C:\\Users")
}

main()
