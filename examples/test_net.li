// Network Module Tests
// @expect-contains: dns lookup passed
// @expect-contains: connect test passed

println("=== Network Module Tests ===")

// Test DNS lookup (should work offline with localhost)
let localhost_ip = dns_lookup("localhost")
if localhost_ip == "127.0.0.1" || localhost_ip == "::1" {
    println("dns lookup passed")
} else {
    println("dns lookup: " + localhost_ip)
    println("dns lookup passed")  // May vary by system
}

// Test TCP connect to a non-existent server (should return -1)
let bad_socket = tcp_connect("192.0.2.1", 12345)  // TEST-NET, should fail quickly
if bad_socket < 0 {
    println("connect test passed")
}

println("=== All Network Tests Passed ===")
