// @expect-error
// A genuinely missing REQUIRED (no-default) parameter must still be an error,
// even when supplied via named arguments. Here `a` has no default and is not
// provided, so the call cannot be satisfied.

fn f(a: int, b: int = 99, c: int = 7) {
    println("${a} ${b} ${c}")
}

fn main() {
    f(b: 5) // missing required parameter 'a'
}

main()
