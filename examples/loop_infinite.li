// Infinite Loop Tests
// Tests the loop {} construct with break and continue

println("=== Basic Loop with Break ===")

// Simple loop with break
var counter = 0
loop {
    counter = counter + 1
    if counter >= 5 {
        break
    }
}
println(counter)  // 5

// Loop with immediate break
loop {
    println("immediate break")
    break
}

println("=== Loop with Counter ===")

// Count to 10
var i = 0
loop {
    i = i + 1
    println(i)
    if i >= 10 {
        break
    }
}

println("=== Loop with Continue ===")

// Print only even numbers
var n = 0
loop {
    n = n + 1
    if n > 10 {
        break
    }
    if n % 2 != 0 {
        continue
    }
    println(n)  // 2, 4, 6, 8, 10
}

println("=== Loop with Multiple Conditions ===")

// Find first number divisible by both 3 and 5
var num = 0
loop {
    num = num + 1
    if num % 3 == 0 && num % 5 == 0 {
        println("Found: " + num)  // 15
        break
    }
    if num > 100 {
        println("Not found")
        break
    }
}

println("=== Nested Loops ===")

// Nested loop - break only exits inner loop
var outer = 0
loop {
    outer = outer + 1
    if outer > 3 {
        break
    }

    var inner = 0
    loop {
        inner = inner + 1
        if inner > 3 {
            break
        }
        println("outer: " + outer + ", inner: " + inner)
    }
}

println("=== Loop as State Machine ===")

// Simple state machine
var state = 0
var iterations = 0
loop {
    iterations = iterations + 1
    if iterations > 10 {
        break
    }

    match state {
        0 => {
            println("State: INIT")
            state = 1
        }
        1 => {
            println("State: RUNNING")
            state = 2
        }
        2 => {
            println("State: DONE")
            break
        }
        _ => {
            println("State: UNKNOWN")
            break
        }
    }
}

println("=== Loop for Input Processing ===")

// Simulate processing items until done
let items = [1, 2, 3, 0, 4, 5]  // 0 is "end marker"
var idx = 0
loop {
    if idx >= len(items) {
        println("End of items")
        break
    }

    let item = items[idx]
    if item == 0 {
        println("Found end marker")
        break
    }

    println("Processing: " + item)
    idx = idx + 1
}

println("=== All Infinite Loop Tests Passed ===")
