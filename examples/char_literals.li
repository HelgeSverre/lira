// Test char literals and operations
// @expect: 97
// @expect: 97
// @expect: newline test
// @expect: 10

fn main() {
    // Basic char literal
    let c = 'a'
    println(c)

    // Char to int conversion
    let code = c as int
    println(code)

    // Escape sequences in chars
    let newline = '\n'
    let tab = '\t'
    let quote = '\''
    let backslash = '\\'

    println("newline test")
    println(newline)
}

main()
