{
  "name": "lira-lang",
  "displayName": "Lira",
  "description": "Syntax highlighting and LSP support for the Lira programming language",
  "version": "0.1.0",
  "publisher": "lira-lang",
  "license": "MIT",
  "author": {
    "name": "Lira Contributors"
  },
  "homepage": "https://github.com/lira-lang/lira",
  "bugs": {
    "url": "https://github.com/lira-lang/lira/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lira-lang/lira"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lira",
    "programming language",
    "systems programming",
    "concurrency",
    "fibers"
  ],
  "activationEvents": [
    "onLanguage:lira"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lira",
        "aliases": [
          "Lira",
          "lira"
        ],
        "extensions": [
          ".li",
          ".lira"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lira",
        "scopeName": "source.lira",
        "path": "./syntaxes/lira.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Lira",
      "properties": {
        "lira.languageServer.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Lira language server"
        },
        "lira.languageServer.path": {
          "type": "string",
          "default": "lira-lsp",
          "description": "Path to the lira-lsp binary"
        }
      }
    },
    "configurationDefaults": {
      "[lira]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "lira",
        "scopes": {
          "function": ["entity.name.function.lira"],
          "function.declaration": ["entity.name.function.definition.lira"],
          "type": ["entity.name.type.lira"],
          "struct": ["entity.name.type.struct.lira"],
          "enum": ["entity.name.type.enum.lira"],
          "variable": ["variable.other.lira"],
          "variable.readonly": ["variable.other.constant.lira"],
          "parameter": ["variable.parameter.lira"],
          "keyword": ["keyword.control.lira"],
          "string": ["string.quoted.double.lira"],
          "number": ["constant.numeric.lira"],
          "comment": ["comment.line.lira"],
          "operator": ["keyword.operator.lira"]
        }
      }
    ],
    "commands": [
      {
        "command": "lira.runFile",
        "title": "Run File",
        "category": "Lira",
        "icon": "$(play)"
      },
      {
        "command": "lira.checkFile",
        "title": "Check File",
        "category": "Lira",
        "icon": "$(check)"
      },
      {
        "command": "lira.showAST",
        "title": "Show AST",
        "category": "Lira",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "lira.runFile",
          "when": "editorLangId == lira",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "lira.runFile",
          "when": "editorLangId == lira",
          "group": "lira@1"
        },
        {
          "command": "lira.checkFile",
          "when": "editorLangId == lira",
          "group": "lira@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lira.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == lira"
      },
      {
        "command": "lira.checkFile",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorLangId == lira"
      }
    ],
    "iconThemes": [
      {
        "id": "lira-icons",
        "label": "Lira File Icons",
        "path": "./icons/lira-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
