{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lira",
  "scopeName": "source.lira",
  "fileTypes": ["li", "lira"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.lira",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.lira",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lira",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lira",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lira",
              "match": "\\\\[nrt\\\\\"'0$]"
            },
            {
              "name": "meta.embedded.lira",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.single.lira",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lira",
              "match": "\\\\[nrt\\\\\"']"
            }
          ]
        },
        {
          "name": "string.quoted.raw.lira",
          "begin": "r\"",
          "end": "\""
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lira",
          "match": "\\b(if|else|match|while|for|loop|in|break|continue|return)\\b"
        },
        {
          "name": "keyword.other.lira",
          "match": "\\b(fn|let|var|const|struct|class|enum|trait|interface|impl|type|pub|priv|static|mut|where)\\b"
        },
        {
          "name": "keyword.control.import.lira",
          "match": "\\b(import|use)\\b"
        },
        {
          "name": "keyword.control.exception.lira",
          "match": "\\b(try|catch|finally)\\b"
        },
        {
          "name": "keyword.control.concurrency.lira",
          "match": "\\b(spawn|select|async)\\b"
        },
        {
          "name": "keyword.operator.lira",
          "match": "\\b(as|is|new|extends|abstract|override)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.lira",
          "match": "\\b(int|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|bool|string|char|void)\\b"
        },
        {
          "name": "storage.type.builtin.lira",
          "match": "\\b(List|Map|Set|Option|Result|Channel)\\b"
        },
        {
          "name": "entity.name.type.lira",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.language.lira",
          "match": "\\b(self|this|super|Self)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.lira",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*[<(]",
          "captures": {
            "1": { "name": "keyword.other.lira" },
            "2": { "name": "entity.name.function.lira" }
          }
        },
        {
          "name": "support.function.builtin.lira",
          "match": "\\b(print|println|debug|assert|len|push|pop|append|panic|todo|unreachable)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lira",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.lira",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.numeric.hex.lira",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.lira",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.octal.lira",
          "match": "\\b0o[0-7]+\\b"
        },
        {
          "name": "constant.numeric.float.lira",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.lira",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.lira",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=)"
        },
        {
          "name": "keyword.operator.comparison.lira",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.lira",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.lira",
          "match": "(\\+\\+|--|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.range.lira",
          "match": "(\\.\\.\\.|\\.\\.|\\.\\.=)"
        },
        {
          "name": "keyword.operator.other.lira",
          "match": "(->|=>|<-|\\?\\?|\\?\\.?|::)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.lira",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.bracket.lira",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
