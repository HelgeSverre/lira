{
  "grammars": [
    {
      "name": "lira",
      "camelcase": "Lira",
      "scope": "source.lira",
      "path": ".",
      "file-types": [
        "li"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^lira$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Lira programming language",
    "links": {
      "repository": "https://github.com/helge/lira.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
