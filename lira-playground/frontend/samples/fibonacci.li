// @title: Fibonacci
// @description: Demonstrates recursion and functions with the classic sequence
// @order: 2
// @category: Getting Started

fn fib(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Print first 10 fibonacci numbers
var i = 0
while i < 10 {
    let result = fib(i)
    println("fib(" + i + ") = " + result)
    i = i + 1
}
