# Rust
/target/
Cargo.lock

# macOS
.DS_Store

# IDEs
.idea/
*.iml
.vscode/
*.code-workspace

# Editor extensions build artifacts
editors/vscode-lira/out/
editors/vscode-lira/node_modules/
editors/vscode-lira/*.vsix
editors/tree-sitter-lira/build/
editors/tree-sitter-lira/node_modules/
editors/jetbrains-lira/build/

# IntelliJ plugin (Gradle)
editors/intellij-lira/.gradle/
editors/intellij-lira/.intellijPlatform/
editors/intellij-lira/build/
editors/intellij-lira/gradle/
editors/intellij-lira/gradlew
editors/intellij-lira/gradlew.bat

# Generated documentation (keep theme/ for custom mdBook styling)
docs/book/*
!docs/book/theme/
docs/stdlib/

# Vercel — keep the project link (project.json) tracked so CLI deploys work
# from a fresh clone, but ignore everything else, especially the *.local env
# files which hold production secrets.
.vercel/*
!.vercel/project.json

# Misc
*.log
*.tmp
*~

# Test/tool artifacts
*.proptest-regressions
mutants.out/
